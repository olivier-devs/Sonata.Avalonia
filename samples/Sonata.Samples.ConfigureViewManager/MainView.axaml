<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:s="clr-namespace:Sonata.Avalonia.Xaml;assembly=Sonata.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Sonata.Samples.ConfigureViewManager.MainView"
        Title="Sonata.Avalonia — ConfigureViewManager sample"
        Width="550" Height="400">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Namespace mapping (AboutViewModel → AboutView):" FontWeight="Bold" />
        <Border BorderBrush="Gray" BorderThickness="1" Padding="10">
            <s:View.Model>
                <Binding Path="About" />
            </s:View.Model>
        </Border>

        <TextBlock Text="Explicit mapping (LegacyEditorViewModel → CustomEditorControl):" FontWeight="Bold" />
        <Border BorderBrush="Gray" BorderThickness="1" Padding="10">
            <s:View.Model>
                <Binding Path="Editor" />
            </s:View.Model>
        </Border>
    </StackPanel>
</Window>
