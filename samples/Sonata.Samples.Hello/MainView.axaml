<Window
    Height="200"
    Title="{Binding DisplayName}"
    Width="550"
    WindowStartupLocation="CenterScreen"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Sonata.Samples.Hello.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/sonata-avalonia/sonata.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">
        <TextBox Text="{Binding Name}" Watermark="Enter your name" />
        <Button Click="{s:Action SayHello}" IsEnabled="{Binding CanSayHello}">Say Hello</Button>
    </StackPanel>
</Window>
