<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>Sonata.Avalonia.Hosting</PackageId>
        <Title>Sonata.Avalonia.Hosting</Title>
        <Description>Generic Host (IHost/IHostedService) integration for Sonata.Avalonia applications.</Description>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Sonata.Avalonia\Sonata.Avalonia.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Sonata.Avalonia.Tests" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\..\LICENSE.txt" Pack="True" PackagePath="\" />
        <None Include="..\..\README.md" Pack="True" PackagePath="\" />
        <None Include="..\..\SonataIcon.png" Pack="True" PackagePath="\" />
    </ItemGroup>
</Project>
